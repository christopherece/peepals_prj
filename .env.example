# Copy to .env.local (git-ignored) and fill in from Supabase: Project Settings → API Keys.
# Leave empty to run in offline mode (reviews stay on the device).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: an account for App Store / Google Play reviewers that signs in with a fixed 6-digit code
# (its Supabase password) instead of an emailed one. See README "Ship it".
EXPO_PUBLIC_REVIEW_EMAIL=
